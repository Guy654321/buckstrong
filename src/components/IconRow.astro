---
import { Icon } from 'astro-icon/components';

interface Props { market?: 'cleveland' | 'cincinnati' | 'general'; }
const { market = 'general' } = Astro.props;

const trustIcons = [
  {
    icon: "mdi:shield-check",
    text: "Insured",
    description: "Fully insured for your protection"
  },
  { 
    icon: "mdi:clock-time-four", 
    text: "24/7 Emergency Service",
    description: "Available 24/7 for urgent repairs"
  },
  { 
    icon: "mdi:tools", 
    text: "All Repairs",
    description: "Complete garage door repair and maintenance"
  },
  { 
    icon: "mdi:star", 
    text: "5-Star Service",
    description: "Highly rated by Cincinnati customers"
  }
];
const displayIcons = market === 'cleveland'
  ? trustIcons.map((item, index) => index === 1
      ? { ...item, text: 'Open 24/7', description: 'Call anytime to confirm the next available visit' }
      : index === 3
      ? { ...item, text: 'Clear Estimates', description: 'Review the work and options before booking' }
      : item)
  : market === 'general'
  ? trustIcons.map((item, index) => index === 1
      ? { ...item, text: 'Open 24/7', description: 'Call anytime about an urgent door issue' }
      : index === 3
      ? { ...item, text: 'Clear Estimates', description: 'Review the work and options before booking' }
      : item)
  : trustIcons;
---

<section class="py-14 bg-white border-b border-ink/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
      {displayIcons.map(item => (
        <div class="text-center">
          <div class="flex items-center justify-center text-ink/70 mb-4">
            <Icon name={item.icon} size="24" class="text-ink/70" aria-hidden="true" />
          </div>
          <p class="text-base font-semibold text-ink/80 mb-2">
            {item.text}
          </p>
          <p class="text-sm text-ink/70 leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
