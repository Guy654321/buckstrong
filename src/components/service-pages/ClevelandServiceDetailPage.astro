---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { Schema } from 'astro-seo-schema';
import Base from '../../layouts/Base.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import ContactForm from '../ContactForm.astro';
import { BUSINESS_INFO } from '../../data/business';
import cleveland from '../../content/locations/cleveland.json';
import { CLEVELAND_SERVICE_INTROS } from '../../data/cleveland-service-details';

export type ClevelandDetailGroup = 'repair' | 'opener' | 'door' | 'commercial';
export type ClevelandDetailService = {
  slug: string;
  serviceName: string;
  cardTitle: string;
  signs: string[];
  processSteps: string[];
  options: string[];
  optionsSummary: string;
  relatedSlugs: readonly string[];
  heroImage: ImageMetadata;
  heroAlt: string;
};

interface Props {
  group: ClevelandDetailGroup;
  service: ClevelandDetailService;
}

const { group, service } = Astro.props as Props;
const hubPaths = {
  repair: '/cleveland-oh/garage-door-repair',
  opener: '/cleveland-oh/opener-repair',
  door: '/cleveland-oh/garage-door-installation',
  commercial: '/cleveland-oh/commercial-jobs',
};
const hubLabels = {
  repair: 'Garage Door Repair',
  opener: 'Opener Repair',
  door: 'Garage Door Installation',
  commercial: 'Commercial Garage Door Service',
};
const detailPath = (slug: string) => {
  if (group === 'repair') return `/cleveland-oh/garage-door-${slug}`;
  if (group === 'opener') return `/garage-door-opener-${slug}-cleveland-oh`;
  if (group === 'commercial') return `/garage-door-commercial-${slug}-cleveland-oh`;
  return `/garage-door-${slug}-cleveland-oh`;
};
const canonical = detailPath(service.slug);
const intro = CLEVELAND_SERVICE_INTROS[service.slug];
if (!intro) throw new Error(`Missing Cleveland service introduction: ${service.slug}`);
const phone = cleveland.phone;
const phoneHref = `tel:${phone.replace(/[^\d+]/g, '')}`;
const title = group === 'repair' && service.slug === 'opener-repair'
  ? 'Garage Door Opener Diagnostics in Cleveland, OH | Buck Strong'
  : `${service.serviceName} in Cleveland, OH | Buck Strong`;
const description = `${intro} Call Buck Strong at ${phone} for Cleveland-area service and availability.`;
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Locations', href: '/locations' },
  { label: 'Cleveland, OH', href: '/locations/cleveland' },
  { label: hubLabels[group], href: hubPaths[group] },
  { label: service.cardTitle },
];
const relatedTitles: Record<string, string> = {
  'spring-replacement': 'Spring Replacement', 'opener-repair': 'Opener Repair',
  'cable-repair': 'Cable Repair', 'track-alignment': 'Track Alignment',
  'panel-replacement': 'Panel Replacement', 'rollers-hinges': 'Roller & Hinge Repair',
  'sensor-alignment': 'Sensor Alignment', weatherstripping: 'Weatherstripping',
  maintenance: 'Maintenance', 'balance-adjustment': 'Balance Adjustment',
  'steel-garage-doors': 'Steel Garage Doors', 'wood-garage-doors': 'Wood Garage Doors',
  'aluminum-garage-doors': 'Aluminum Garage Doors',
  'carriage-house-garage-doors': 'Carriage House Garage Doors',
  'warehouse-distribution-door-service': 'Warehouse & Distribution Doors',
  'dock-industrial-door-equipment-service': 'Dock & Industrial Equipment',
  'retail-municipal-garage-door-service': 'Retail & Municipal Doors',
};
const relatedLinks = service.relatedSlugs
  .filter((slug) => group !== 'opener' || slug !== 'opener-repair')
  .map((slug) => ({ label: relatedTitles[slug] ?? slug.replaceAll('-', ' '), href: group === 'opener' ? `/cleveland-oh/garage-door-${slug}` : detailPath(slug) }));
---

<Base title={title} description={description} canonical={canonical} callNowPhoneNumber={phone}>
  <Nav />
  <Breadcrumbs items={breadcrumbs} />

  <Schema item={{
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${service.serviceName} in Cleveland, OH`,
    description,
    serviceType: service.serviceName,
    areaServed: [
      { '@type': 'City', name: 'Cleveland' },
      { '@type': 'City', name: 'Westlake' },
      { '@type': 'AdministrativeArea', name: 'Greater Cleveland' },
    ],
    provider: {
      '@type': 'LocalBusiness',
      name: BUSINESS_INFO.name,
      legalName: BUSINESS_INFO.legalName,
      telephone: phone,
      address: { '@type': 'PostalAddress', ...cleveland.address },
      openingHoursSpecification: [{
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
        opens: '00:00',
        closes: '23:59',
      }],
    },
  }} />

  <main>
  <section class="py-16 bg-muted">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid items-center gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
      <div>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-6">{service.serviceName} in Cleveland, OH</h1>
        <p class="text-lg leading-relaxed text-ink/80 mb-4">{intro}</p>
        <p class="text-lg leading-relaxed text-ink/80 mb-6">We serve Cleveland and selected surrounding communities from our Westlake market. Call with your address so we can confirm coverage and appointment availability.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={phoneHref} class="btn-accent px-6 py-3 text-center">Call Now: {phone}</a>
          <a href="#service-quote" class="btn-primary px-6 py-3 text-center">Get a Quote</a>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-xl ring-1 ring-black/5 bg-white/50">
        <Picture src={service.heroImage} alt={service.heroAlt.replaceAll('Cincinnati', 'Cleveland')} widths={[480, 768, 1024]} sizes="(min-width: 1024px) 40vw, 100vw" quality={82} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
      </div>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-ink mb-6">Signs You Need This Service</h2>
      <ul class="list-disc list-inside space-y-3 text-lg text-ink/80 leading-relaxed">
        {service.signs.map((sign) => <li>{sign}</li>)}
      </ul>
    </div>
  </section>

  <section class="py-14 bg-muted">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-ink mb-6">Our Assessment and Process</h2>
      <ol class="list-decimal list-inside space-y-3 text-lg text-ink/80 leading-relaxed">
        {service.processSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="py-14 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-ink mb-6">Available Options</h2>
      <ul class="list-disc list-inside space-y-3 text-lg text-ink/80 leading-relaxed mb-5">
        {service.options.map((option) => <li>{option}</li>)}
      </ul>
      <p class="text-lg text-ink/80 leading-relaxed">{service.optionsSummary.replace('Cincinnati humidity and freeze-thaw swings', 'changing humidity and temperature swings')}</p>
    </div>
  </section>

  <section class="py-14 bg-muted">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-ink mb-6">Related Garage Door Services</h2>
      <p class="text-lg text-ink/80 leading-relaxed mb-5">See the <a class="text-primary underline" href={hubPaths[group]}>{hubLabels[group].toLowerCase()} overview</a> or compare a related service:</p>
      <ul class="list-disc list-inside space-y-2 text-lg">
        {relatedLinks.map((link) => <li><a class="text-primary underline" href={link.href}>{link.label}</a></li>)}
      </ul>
      <p class="text-lg text-ink/80 leading-relaxed mt-6">Buck Strong Garage Doors · {cleveland.address.streetAddress}, {cleveland.address.addressLocality}, {cleveland.address.addressRegion} {cleveland.address.postalCode}. Open 24/7 for calls at <a class="text-primary underline" href={phoneHref}>{phone}</a>.</p>
    </div>
  </section>

  <ContactForm id="service-quote" includeSchema={false} title={`Request ${service.cardTitle} Service`} subtitle="Tell us about your door and address. We will confirm Cleveland-area coverage and scheduling options." bgColor="white" />
  </main>
  <Footer />
</Base>
