---
import { Schema } from 'astro-seo-schema';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQInteractive from '../components/FAQInteractive.astro';
import CallNowButton from '../components/CallNowButton.astro';
import HiddenSeoText from '../components/HiddenSeoText.astro';
import heroImage from '../assets/images/dillon-kydd-XGvwt544g8k-unsplash.jpg';
import { BUSINESS_INFO } from '../data/business';
import { CALL_MARKETS, DEFAULT_CALL_MARKET } from '../data/call-markets';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'FAQ' }
];

const resourceLinks = [
  {
    title: 'Schedule Service',
    description: 'Ask about garage door repair or installation in the Cincinnati or Cleveland market.',
    href: '/contact',
    icon: 'mdi:calendar-clock'
  },
  {
    title: 'Explore Garage Door Services',
    description: 'Compare repair, installation, and opener services for your home or business.',
    href: '/services',
    icon: 'mdi:tools'
  },
  {
    title: 'Find Your Neighborhood',
    description: 'View service areas around Cincinnati and Cleveland.',
    href: '/locations',
    icon: 'mdi:map-marker-radius'
  },
  {
    title: 'Read Safety Guidelines',
    description: 'Follow professional checklists to keep your overhead door operating safely.',
    href: '/safety',
    icon: 'mdi:shield-check'
  },
  {
    title: 'Visit the Blog',
    description: 'Learn maintenance tips and troubleshooting advice from our experts.',
    href: '/blog',
    icon: 'mdi:newspaper-variant-outline'
  }
];

const displayPhoneNumber = BUSINESS_INFO.telephone;
const telephoneHref = `tel:${displayPhoneNumber.replace(/[^0-9+]/g, '') || displayPhoneNumber}`;

const callMarkets = CALL_MARKETS;
const defaultCallMarket = DEFAULT_CALL_MARKET;
const callModalId = 'header-call-modal';

// Categorized FAQs for better organization
const generalFaqs = [
  {
    question: "Do you provide upfront pricing for garage door repairs?",
    answer:
      "Yes. We diagnose the issue, share a written estimate before work starts, and explain every line item so there are no surprises."
  },
  {
    question: "What do garage door services typically cost?",
    answer:
      "Pricing depends on the door, the parts needed, and the work involved. We inspect the system and explain the options before providing an estimate. Call your Cincinnati or Cleveland team for help with a specific project."
  },
  {
    question: "How soon can you repair my garage door?",
    answer:
      "Call with your address and a description of the problem. We will confirm coverage and the next available appointment in your market. If the door is stuck open or unsafe, tell us when you call."
  },
  {
    question: "Do you provide warranties on garage door repairs?",
    answer:
      "Yes. Repairs and installations include manufacturer warranties plus our satisfaction guarantee. If anything falls short, we return quickly to make it right."
  }
];

const serviceFaqs = [
  {
    question: "What garage door brands do you service?",
    answer:
      "We work on many common door and opener brands, including Clopay, Wayne Dalton, Amarr, LiftMaster, Genie, and Chamberlain. Tell us the brand and model when you contact us so we can discuss the right service options."
  },
  {
    question: "Can you repair garage door springs safely?",
    answer:
      "Yes. Spring repair needs special tools and training because of the high tension. We handle torsion, extension, and high-cycle springs with strict safety steps to protect your home."
  },
  {
    question: "Do you install smart garage door openers?",
    answer:
      "Yes. We install and service smart openers with WiFi, phone apps, and smart home connections, including LiftMaster MyQ and Genie Aladdin Connect."
  },
  {
    question: "Which garage door services do you offer?",
    answer:
      "We handle tune-ups, spring and cable repairs, opener problems, panel replacement, weather sealing, and new door installation. Commercial service is also available. Call with your address to confirm coverage and scheduling in Cincinnati or Cleveland."
  },
  {
    question: "Do you service commercial overhead and roll-up doors?",
    answer:
      "Yes. We can discuss service for sectional overhead doors, rolling steel doors, and other commercial openings. Tell us about the equipment and location so we can confirm the right service options."
  }
];

const emergencyFaqs = [
  {
    question: "What should I do if my garage door won't open?",
    answer:
      "Confirm the opener is plugged in and the remote batteries are fresh. Check the tracks and sensors for obstructions. If it still will not move, stop forcing the door and call us to avoid a safety risk."
  },
  {
    question: "Do you provide emergency garage door repair?",
    answer:
      "Our Cincinnati and Cleveland lines are open 24/7 for urgent requests. If the door is stuck open, will not close, or creates a safety concern, call your local number and we will confirm the next available visit."
  }
];

const maintenanceFaqs = [
  {
    question: "How often should I have my garage door serviced?",
    answer:
      "Schedule professional maintenance once a year for spring adjustments, lubrication, and safety tests. Add simple monthly DIY checks to keep everything running smoothly."
  },
  {
    question: "Is it safe to repair my garage door myself?",
    answer:
      "Cleaning and lubrication are safe DIY tasks. Leave spring, cable, or opener repairs to a pro because those parts stay under high tension."
  },
  {
    question: "What causes garage door springs to break?",
    answer:
      "Springs wear out after thousands of cycles. Metal fatigue, moisture, temperature swings, and skipped maintenance speed up failure. Most last seven to ten years before replacement."
  },
  {
    question: "Do you offer maintenance plans for garage doors?",
    answer:
      "Yes. Our tune-up program includes lubrication, track alignment, safety testing, and sensor cleaning to extend the life of your overhead door."
  }
];

const locationFaqs = [
  {
    question: "Which Cincinnati areas do you serve?",
    answer:
      "Our Cincinnati service area includes the city and nearby communities such as Hyde Park, Oakley, Blue Ash, West Chester, and Mason. See the Cincinnati location hub for the full list, and call to confirm service at your address."
  },
  {
    question: "Which Cleveland areas do you serve?",
    answer:
      "Our Cleveland area includes the city and selected suburbs such as Westlake, Rocky River, Avon, Strongsville, Brecksville, and Solon. See the Cleveland location hub for the full list, and call to confirm service at your address."
  },
  {
    question: "Are you insured for work in Ohio?",
    answer:
      "Yes. We maintain full liability and workers compensation coverage for Ohio. All technicians are background-checked, trained, and follow strict safety standards."
  }
];

const troubleshootingFaqs = [
  {
    question: "Can you match my existing garage door for repairs?",
    answer:
      "In most cases we can match your existing door because we stock common panels, hardware, and parts. For custom or discontinued doors, we source close matches or suggest alternatives that blend in."
  },
  {
    question: "Why is my garage door making loud noises?",
    answer:
      "Worn rollers, loose hardware, dry hinges, or worn drive chains and belts often cause noise. Grinding sounds can signal serious issues, so call a professional to inspect and repair them."
  },
  {
    question: "Do you service commercial garage doors?",
    answer:
      "Yes. We help with commercial overhead and roll-up doors in both markets. Tell us the door type, property address, and issue so we can confirm coverage and the appropriate next step."
  },
  {
    question: "How do I know if my garage door needs professional service?",
    answer:
      "Call us when the door hangs uneven, slams shut, shakes during operation, or the opener light flashes repeatedly. These symptoms often signal worn springs or misaligned tracks."
  }
];

// Combine all FAQs for schema markup
const allFaqs = [...generalFaqs, ...serviceFaqs, ...emergencyFaqs, ...maintenanceFaqs, ...locationFaqs, ...troubleshootingFaqs];

const faqSchemaItems = allFaqs.map(faq => ({
  '@type': 'Question' as const,
  name: faq.question,
  acceptedAnswer: {
    '@type': 'Answer' as const,
    text: faq.answer
  }
})) satisfies {
  '@type': 'Question';
  name: string;
  acceptedAnswer: {
    '@type': 'Answer';
    text: string;
  };
}[];

const faqSections = [
  {
    id: 'general',
    title: 'General Information',
    description: 'Basic information about our services and policies',
    icon: 'mdi:information',
    iconClass: 'text-primary',
    iconBg: 'bg-primary/10',
    faqs: generalFaqs
  },
  {
    id: 'services',
    title: 'Our Services',
    description: 'What we repair, install, and maintain',
    icon: 'mdi:tools',
    iconClass: 'text-accent',
    iconBg: 'bg-accent/10',
    faqs: serviceFaqs
  },
  {
    id: 'emergency',
    title: 'Emergency Situations',
    description: 'What to do when your garage door fails',
    icon: 'mdi:alert-circle',
    iconClass: 'text-red-600',
    iconBg: 'bg-red-100',
    faqs: emergencyFaqs
  },
  {
    id: 'maintenance',
    title: 'Maintenance & Safety',
    description: 'Keeping your garage door in top condition',
    icon: 'mdi:wrench',
    iconClass: 'text-green-600',
    iconBg: 'bg-green-100',
    faqs: maintenanceFaqs
  },
  {
    id: 'location',
    title: 'Service Area & Licensing',
    description: 'Where we serve and our credentials',
    icon: 'mdi:map-marker',
    iconClass: 'text-blue-600',
    iconBg: 'bg-blue-100',
    faqs: locationFaqs
  },
  {
    id: 'troubleshooting',
    title: 'Troubleshooting & Repairs',
    description: 'Common problems and professional solutions',
    icon: 'mdi:help-circle',
    iconClass: 'text-purple-600',
    iconBg: 'bg-purple-100',
    faqs: troubleshootingFaqs
  }
] as const;
---

<Base
  title="Garage Door FAQ | Cincinnati & Cleveland | Buck Strong"
  description="Answers to garage door repair, installation, opener, pricing, and scheduling questions for Cincinnati and Cleveland homeowners. Find your local service area."
  schemaType="FAQPage"
>
  <Nav />
  <Breadcrumbs items={breadcrumbs} />
  <div id="top" class="sr-only" aria-hidden="true"></div>
  
  
  <section class="relative py-20 text-white overflow-hidden">
    <div class="absolute inset-0">
      <Image 
        src={heroImage}
        alt="Garage door and home exterior representing Buck Strong Garage Doors service questions"
        width="1200"
        height="675"
        class="w-full h-full object-cover" 
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        quality={72}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-primary/75"></div>
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="relative">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Frequently Asked Questions
        </h1>
        <p class="text-xl md:text-2xl text-white/90 mb-8 max-w-4xl mx-auto leading-relaxed">
          Clear answers about repairs, installation, openers, and scheduling for homeowners in Cincinnati and Cleveland.
        </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            {callMarkets.length > 0 && defaultCallMarket ? (
              <button
                type="button"
                class="btn-accent text-sm sm:text-base lg:text-lg px-4 sm:px-6 lg:px-8 py-3 sm:py-4 inline-flex items-center justify-center font-semibold w-full sm:w-auto gap-2"
                data-call-modal-trigger
                aria-controls={callModalId}
                aria-expanded="false"
                aria-haspopup="dialog"
                aria-label="Choose a service area phone number"
              >
                <Icon name="mdi:phone" size="20" class="inline" aria-hidden="true" />
                <span>Call Now</span>
                <span class="sr-only">for the {defaultCallMarket.label} market</span>
              </button>
            ) : (
              <a href={telephoneHref} class="btn-accent text-lg px-8 py-4 inline-flex items-center justify-center font-semibold w-full sm:w-auto gap-2">
                <Icon name="mdi:phone" size="20" class="inline" aria-hidden="true" />
                <span>Call Now</span>
                <span class="nap-phone">{displayPhoneNumber}</span>
              </a>
            )}
            <a href="/contact" class="btn-outline-light text-lg px-8 py-4 inline-flex items-center justify-center font-semibold w-full sm:w-auto bg-white/10 hover:bg-white/20 gap-2">
              <Icon name="mdi:email" size="20" class="inline" aria-hidden="true" />
              Get Free Quote
            </a>
          </div>
      </div>
    </div>
  </section>
  
  
  <section class="py-16 bg-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-ink mb-4">Find Your Answer</h2>
        <p class="text-xl text-ink/70">Browse by category to find the topic you need.</p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <a href="#general" class="bg-white rounded-lg p-4 text-center hover:shadow-lg transform-gpu transition-transform duration-300 group hover:-translate-y-1 focus-visible:-translate-y-1">
          <div class="bg-primary/10 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-primary/20 transition-colors">
            <Icon name="mdi:information" size="24" class="text-primary" aria-hidden="true" />
          </div>
          <span class="text-sm font-semibold text-ink">General Info</span>
        </a>
        
        <a href="#services" class="bg-white rounded-lg p-4 text-center hover:shadow-lg transform-gpu transition-transform duration-300 group hover:-translate-y-1 focus-visible:-translate-y-1">
          <div class="bg-accent/10 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-accent/20 transition-colors">
            <Icon name="mdi:tools" size="24" class="text-accent" aria-hidden="true" />
          </div>
          <span class="text-sm font-semibold text-ink">Services</span>
        </a>
        
        <a href="#emergency" class="bg-white rounded-lg p-4 text-center hover:shadow-lg transform-gpu transition-transform duration-300 group hover:-translate-y-1 focus-visible:-translate-y-1">
          <div class="bg-red-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-red-200 transition-colors">
            <Icon name="mdi:alert-circle" size="24" class="text-red-600" aria-hidden="true" />
          </div>
          <span class="text-sm font-semibold text-ink">Emergency</span>
        </a>
        
        <a href="#maintenance" class="bg-white rounded-lg p-4 text-center hover:shadow-lg transform-gpu transition-transform duration-300 group hover:-translate-y-1 focus-visible:-translate-y-1">
          <div class="bg-green-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-green-200 transition-colors">
            <Icon name="mdi:wrench" size="24" class="text-green-600" aria-hidden="true" />
          </div>
          <span class="text-sm font-semibold text-ink">Maintenance</span>
        </a>
        
        <a href="#location" class="bg-white rounded-lg p-4 text-center hover:shadow-lg transform-gpu transition-transform duration-300 group hover:-translate-y-1 focus-visible:-translate-y-1">
          <div class="bg-blue-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-blue-200 transition-colors">
            <Icon name="mdi:map-marker" size="24" class="text-blue-600" aria-hidden="true" />
          </div>
          <span class="text-sm font-semibold text-ink">Location</span>
        </a>
        
        <a href="#troubleshooting" class="bg-white rounded-lg p-4 text-center hover:shadow-lg transform-gpu transition-transform duration-300 group hover:-translate-y-1 focus-visible:-translate-y-1">
          <div class="bg-purple-100 w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-3 group-hover:bg-purple-200 transition-colors">
            <Icon name="mdi:help-circle" size="24" class="text-purple-600" aria-hidden="true" />
          </div>
          <span class="text-sm font-semibold text-ink">Troubleshooting</span>
        </a>
      </div>
    </div>
  </section>


  <section class="py-12 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
        <div class="space-y-3">
          <h2 class="text-3xl font-bold text-ink">Quick answers in plain language</h2>
          <p class="text-lg text-ink/75 leading-relaxed">
            Start with these simple guidelines before diving into the detailed FAQs.
          </p>
          <ul class="list-disc list-inside space-y-2 text-base text-ink/80 leading-relaxed">
            <li>Keep remotes stocked with fresh batteries and check photo-eye sensors for dust.</li>
            <li>Do not force a stuck door; disconnect power and call for help to avoid injuries.</li>
            <li>Schedule annual tune-ups for springs, rollers, and opener safety tests.</li>
            <li>Ask for written estimates so pricing stays clear before work begins.</li>
          </ul>
        </div>
        <div class="rounded-2xl bg-muted p-6 shadow-sm ring-1 ring-black/5 space-y-3">
          <h3 class="text-2xl font-semibold text-ink">Need it fast?</h3>
          <p class="text-base text-ink/75 leading-relaxed">
            Call your local team or send a quick note. We will review the issue and confirm the next available appointment.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            {callMarkets.length > 0 && defaultCallMarket ? (
              <button type="button" class="btn-accent w-full sm:w-auto justify-center text-base" data-call-modal-trigger aria-controls={callModalId} aria-expanded="false" aria-haspopup="dialog" aria-label="Choose a service area phone number">Call your local team</button>
            ) : (
              <a href={telephoneHref} class="btn-accent w-full sm:w-auto justify-center text-base">Call your local team</a>
            )}
            <a href="/contact" class="btn-outline w-full sm:w-auto justify-center text-base">Send details</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section class="py-16 bg-muted">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-ink mb-4">Browse Answers by Topic</h2>
        <p class="text-xl text-ink/70">Explore the most requested garage door questions, organized for quick scanning.</p>
      </div>

      <div class="space-y-10">
        {faqSections.map((section, index) => (
          <div id={section.id} class="scroll-mt-28">
            <div class={`rounded-2xl p-6 md:p-8 shadow-sm ring-1 ring-black/5 ${index % 2 === 0 ? 'bg-white' : 'bg-card'}`}>
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
                <div class="flex items-center gap-4">
                  <div class={`${section.iconBg} w-12 h-12 rounded-full flex items-center justify-center`}>
                    <Icon name={section.icon} size="24" class={section.iconClass} aria-hidden="true" />
                  </div>
                  <div>
                    <h2 class="text-2xl font-bold text-ink">{section.title}</h2>
                    <p class="text-ink/70">{section.description}</p>
                  </div>
                </div>
                <a href="#top" class="text-sm font-semibold text-primary hover:text-accent transition-colors hidden md:inline-flex items-center gap-2">
                  Back to top
                  <Icon name="mdi:arrow-up" size="18" aria-hidden="true" />
                </a>
              </div>
              <FAQInteractive faqs={section.faqs} />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  
  
  <section class="py-16 bg-card">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-ink mb-4">Service in Cincinnati and Cleveland</h2>
        <p class="text-xl text-ink/70">Find the right local team and confirm service for your address.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <div class="bg-muted rounded-2xl p-8 shadow-sm ring-1 ring-black/5">
          <h3 class="text-2xl font-semibold text-ink mb-4">Cincinnati, OH</h3>
          <ul class="list-disc list-inside text-ink/80 space-y-2">
            <li>Garage door repair, opener service, and installation in the Cincinnati metro</li>
            <li>Coverage includes the city and selected nearby communities</li>
            <li>Call <a class="inline-link" href="tel:5137788005">(513) 778-8005</a> to discuss your address and the next available visit</li>
            <li><a class="inline-link" href="/locations/cincinnati">Explore Cincinnati service areas</a></li>
          </ul>
        </div>
        <div class="bg-muted rounded-2xl p-8 shadow-sm ring-1 ring-black/5">
          <h3 class="text-2xl font-semibold text-ink mb-4">Cleveland, OH</h3>
          <ul class="list-disc list-inside text-ink/80 space-y-2">
            <li>Garage door repair, opener service, installation, and commercial work in Greater Cleveland</li>
            <li>Coverage includes the city and selected west, south, and east side suburbs</li>
            <li>Call <a class="inline-link" href="tel:2169302980">(216) 930-2980</a> to confirm coverage and scheduling</li>
            <li><a class="inline-link" href="/locations/cleveland">Explore Cleveland service areas</a></li>
          </ul>
        </div>
        <div class="bg-muted rounded-2xl p-8 shadow-sm ring-1 ring-black/5">
          <h3 class="text-2xl font-semibold text-ink mb-4">What to Have Ready</h3>
          <ul class="list-disc list-inside text-ink/80 space-y-2">
            <li>Your street address and preferred contact number</li>
            <li>A short description of what the door is doing</li>
            <li>The door or opener brand, if you know it</li>
            <li>Any immediate safety or access concern</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  
  <section class="py-16 bg-muted">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-ink mb-4">Trusted Garage Door Brands & Quality Parts</h2>
        <p class="text-xl text-ink/70">We recommend parts that fit the door, the opening, and the conditions at your property.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="bg-card rounded-2xl p-8 shadow-sm ring-1 ring-black/5">
          <h3 class="text-2xl font-bold text-ink mb-4">Professional Brands We Install & Service</h3>
          <p class="text-lg text-ink/70 mb-4">
            We inspect the door before recommending springs, cables, rollers, or opener components. The right choice depends on door weight, usage, and the condition of the existing system.
          </p>
          <p class="text-lg text-ink/70 mb-4">
            Whether you prefer LiftMaster, Chamberlain, Genie, Craftsman, Raynor, CHI Overhead Door, or other premium brands, we install and program them all. We also integrate smart keypads, battery backups, and LED lighting upgrades.
          </p>
          <p class="text-lg text-ink/70">
            Every component is installed to manufacturer specifications and includes comprehensive safety testing.
          </p>
        </div>
        <div class="bg-card rounded-2xl p-8 shadow-sm ring-1 ring-black/5">
          <h3 class="text-2xl font-semibold text-ink mb-4">Quality Replacement Parts Available</h3>
          <ul class="list-disc list-inside text-ink/80 space-y-2">
            <li>High-cycle torsion and extension springs for extended lifespan</li>
            <li>LiftMaster, Chamberlain, and Genie belt-drive and chain-drive openers</li>
            <li>MyQ smart technology, HomeLink, and universal remote programming</li>
            <li>Insulated steel, wood composite, and aluminum panels</li>
            <li>Roll-up door slats, guides, and counterbalance drum systems</li>
            <li>Premium weather seals, bottom rubber, and perimeter trim</li>
            <li>Commercial-grade hardware for heavy-duty applications</li>
            <li>Energy-efficient insulation and weatherproofing materials</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  
  <section class="py-16 bg-card">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-ink mb-4">Popular Garage Door Sizes & Dimensions</h2>
        <p class="text-xl text-ink/70">From compact single doors to oversized multi-bay installations, we handle all standard and custom sizes</p>
      </div>

      <div class="bg-muted rounded-2xl p-8 shadow-sm ring-1 ring-black/5">
        <h3 class="text-2xl font-semibold text-ink mb-6">Common Residential Door Sizes</h3>
        <p class="text-ink/70 mb-6">
          If you need a replacement door, measure the opening and tell us about the space around it. We will confirm the dimensions and discuss available options before ordering.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 text-ink/80">
          <div>
