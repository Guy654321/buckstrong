---
import ClevelandServiceDetailPage from '../components/service-pages/ClevelandServiceDetailPage.astro';
import { COMMERCIAL_SERVICE_PAGES } from '../data/commercial-service-pages';

export function getStaticPaths() {
  return COMMERCIAL_SERVICE_PAGES.map((service) => ({
    params: { service: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
---

<ClevelandServiceDetailPage group="commercial" service={service} />
